# Environment for the cluster. On the cluster, copy it once to .env (ignored by git):
#   cp cluster.env .env
# then run, as on the PC:
#   docker compose up --build
# The simulations write to the volume angela.cortecchia-volume, and the charts are not made.
COMPOSE_FILE=docker-compose.yml:docker-compose.cluster.yml
COMPOSE_PATH_SEPARATOR=:
# Number of seeds of the simulations (on the PC the default of docker-compose.yml is used: 5)
MAX_SEED=50
